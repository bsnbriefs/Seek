{
  "rewrites": [
    {
      "source": "/request/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i)whatsapp|facebookexternalhit|facebot|twitterbot|slackbot|telegrambot"
        }
      ],
      "destination": "/api/request-meta?id=:id"
    },
    {
      "source": "/impact/:id",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i)whatsapp|facebookexternalhit|facebot|twitterbot|slackbot|telegrambot"
        }
      ],
      "destination": "/api/impact-meta?id=:id"
    },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
